    "   \"source\": [\n",
    "    \"# Try different polygon styles and compare\\n\",\n",
    "    \"styles = ['irregular', 'concave', 'convex']\\n\",\n",
    "    \"fig, axes = plt.subplots(2, 3, figsize=(15, 8), constrained_layout=True)\\n\",\n",
